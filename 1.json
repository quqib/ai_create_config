            "url": "http://www.ccgp-tianjin.gov.cn/commons/image.jsp",
            "headers": {
                "Accept": "image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8",
                "Accept-Encoding": "gzip, deflate",
                "Accept-Language": "zh-CN,zh;q=0.9",
                "Host": "www.ccgp-tianjin.gov.cn",
                "Referer": "${list_url}",
                      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36"
                  },
                  "captcha_config": { //验证码类型配置
                      "type": "math",  //验证码类型  abc_num表示识别字母和数字，math表示数值计算，multi_slide表示缺口滑块识别（无需自定义Y坐标，获取验证码会返回Y坐标），block_puzzle表示缺口滑块识别（自定义Y坐标）
                      "length": 4,  //验证码长度
                      "iscase": False,  //是否区分大小写
                  },
        "respheaders": ["captcha-uuid"],  //需要提取响应头返回的参数，如captcha-uuid，用于后续请求替换变量
                  "response_type": "image",  //image表示返回图片二进制流，base64表示图片base64，json表示图片在json中，file表示文件
        "encrypt":[{"type":"aes","key":"${secretKey}","iv":"","mode":1,"padding":"pkcs7","value":'{"x":${captcha_code},"y":5}'}],  //验证码识别结果加密，value为加密原字符串，${secretKey}为前置请求中提取的变量值替换，${captcha_code}表示验证码识别后的结果替换
              },
              {
                  "name": "get_file",
                  "method": "GET",
                  "url": "http://www.ccgp-tianjin.gov.cn/portal/documentView.do?imageString=${captcha_code}&method=downNewFiles&verificationCodeGuid=${verificationCodeGuid}",  //${captcha_code}表示验证码识别结果替换，字段名不可变, ${verificationCodeGuid}表示前面流程提取到的字段替换
            "issave": False, //是否固证，只有list和detail获取结果或者单独请求获取附件列表配置部分默认固证，其他部分不固证，不配置该字段表示固证
            "isredirect": False,  //是否重定向
                  "check_success":"\"message\":\"\"",  //通过检测响应体内容来判断提交验证码是否验证成功
                 "check_fail":"验证码验证失败",  //通过检测响应体内容来判断提交验证码是否验证失败
            "headers": {  //请求头
                "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7",
                "Accept-Encoding": "gzip, deflate",
                "Accept-Language": "zh-CN,zh;q=0.9",
                "Host": "www.ccgp-tianjin.gov.cn",
                "Upgrade-Insecure-Requests": "1",
                "Referer": "${list_url}",
                      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36"
                  },
                  "response_type": "file",  //响应返回内容类型，image表示返回图片二进制流，json表示图片以base64格式在json中，file表示文件,list表示列表信息
              },
          ],
      },
      "fields": { //字段名可增删，但是需要同步给汪盼和业务相关人
      "url": {   //字段提取，附件URL，字段名不可变，如果附件存在于iframe网页, 则提取规则在iframe网页里
        "type": "xpath", //字段提取方式，xpath/jsonpath/regex
        "value": "//ul[@class='info_list2']/li", //提取表达式
          "extra": { //额外字段提取
              "fileserice": { //字段名，可自定义
                  "type": "jsonpath",   //字段提取方式，xpath/jsonpath/regex
                  "value": "$.data.list[*].fileServiceId", //提取表达式
              }
          },
          "ifelse":["'${fileserice}'=='old'","https://ggzy.hzctc.hangzhou.gov.cn:20001/UService/DownLoadFile.aspx?dirtype=3&filepath=${url}","https://ggzy.hzctc.hangzhou.gov.cn/api/file/download/${fileserice}"], //根据规则列表自动生成最终URL，一种判断条件则规则为三元素列表 [条件, 真URL, 假URL] ，如果存在多个条件判断，则规则为[[条件1, URL1], [条件2, URL2], ..., 默认URL]
        "prepath":True //用于补全链接url，功能与python的urllib.parse.urljoin函数一样
        },
      "name": {   //字段提取，附件名，字段名不可变，如果附件存在于iframe网页, 则提取规则在iframe网页里
        "type": "xpath", //字段提取方式，xpath/jsonpath/regex
        "value": "//ul[@class='info_list2']/li", //提取表达式
        "ishtml": True,  //表示提取到的URL下载的文件为html文件
        "isnull": True  //表示该字段可以为空值
        },
        "size": {   //字段提取，附件大小，字段名不可变，如果附件存在于iframe网页, 则提取规则在iframe网页里，该字段提取到的值大于初始设置文件大小阈值，则该文件不下载
          "type": "xpath", //字段提取方式，xpath/jsonpath/regex
          "value": "//ul[@class='info_list2']/li", //提取表达式
          "isnull": True  //表示该字段可以为空值
          }
          }
      }
     }
  },
  "pagination": { //翻页
    "url": "https://XXXXXXX/XXXXX/XXXXX_${page_param}.html?XXXX=${__VIEWSTATE}", //${page_param} 表示翻页URL页码变量，后面做替换 ,${page_param}默认固定写法，如果存在结合起止时间查询，需要配置起止时间变量${starttime}和${endtime},${__VIEWSTATE}表示额外提取翻页变量，如果翻页需要截止索引且该字段值需要计算，则书写为@calc:{表达式},表达式需要页码，则可以书写成如@calc:{${page_param}+44}形式
    "headers": {
    "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36"
    },
    "enable": True, //表示是否翻页，True表示翻页，False表示不翻页
    "max_page": 5, //表示最大翻页数，无该字段表示不限制最大翻页数
    "extra":{  //翻页URL额外变量提取
        "__VIEWSTATE":{
            "type": "xpath",
            "value": "//input[@id='__VIEWSTATE']/@value",
        },
        "__EVENTVALIDATION": {
            "type":"xpath",
            "value":"//input[@id='__EVENTVALIDATION']/@value",
        },
    },
    "page_param": {  //该字段名不可改动
    "current": 0, //表示当前URL页码数，默认为首页URL中页码数
    "start": 0, //表示首页URL中页码数
    "step":1,  //翻页步长
    "offset":1,  //多步长的起始位置偏移量
    "total": { //表示总页码数，和数据记录总量、下一页翻页必须存在一个
      "type": "regex", //字段提取方式，xpath/jsonpath/regex
      "value": "total:\\s*'(\\d+)'" //提取表达式
      },
      "count": { //表示数据记录总量，和总页码数、下一页翻页必须存在一个
        "type": "regex",
        "value": "count:\\s*'(\\d+)'"
      },
      "next": { //表示下一页翻页，如果存在提取结果就下一页，否则终止下一页翻页，和总页码、数据记录总量数必须存在一个
          "type": "xpath",
          "value": "(//div[@class='pager']//li[contains(@class,'ewb-page-li') and contains(@class,'current')]/following-sibling::li[1]/a[@href])[last()]",
      }
      "per_num": 10, //表示每页数据记录量
    }
  },